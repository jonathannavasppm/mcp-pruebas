{
  "outputFile": "./output/report.xlsx",
  "projects": [
    {
      "name": "proyecto-prueba",
      "sources": [
        {
          "id": "vulnerabilities",
          "sheetName": "Vulnerabilidades",
          "type": "npm-audit",
          "enabled": true,
          "config": {
            "pathProject": "/Users/jonathan.navas/Documents/pruebas/my-next-app",
            "branch": "develop_v2",
            "timeToCompare": "6 months"
          }
        },
        {
          "id": "code-quality",
          "sheetName": "SonarQube",
          "type": "sonarqube",
          "enabled": true,
          "config": {
            "apiKeyEnv": "SONARQUBE_API_KEY",
            "baseUrl": "https://sonarqube.example.com",
            "projectKey": "my-next-app",
            "branch": "develop_v2",
            "metrics": [
              "coverage",
              "bugs",
              "vulnerabilities",
              "code_smells",
              "duplicated_lines_density"
            ]
          }
        },
        {
          "id": "uptime",
          "sheetName": "UptimeRobot",
          "type": "uptime-robot",
          "enabled": true,
          "config": {
            "apiKeyEnv": "UPTIME_ROBOT_API_KEY",
            "projectName": "Project Name"
          }
        },
        {
          "id": "jira",
          "sheetName": "Jira",
          "type": "jira",
          "enabled": true,
          "config": {
            "apiKeyEnv": "JIRA_API_TOKEN",
            "emailEnv": "JIRA_EMAIL",
            "baseUrlEnv": "JIRA_URL",
            "projectName": "Project Name",
            "jql": "project = 'Project Name' AND status != Done ORDER BY created DESC"
          }
        }
      ]
    },
    {
      "name": "football-report",
      "sources": [
        {
          "id": "la-liga",
          "sheetName": "LaLiga",
          "type": "http",
          "enabled": true,
          "config": {
            "url": "https://api.football-data.org/v4/competitions/PD/matches",
            "method": "GET",
            "apiKeyEnv": "FOOTBALL_DATA_API_KEY",
            "apiKeyHeader": "X-Auth-Token",
            "fieldMapping": {
              "rowsPath": "$.matches",
              "competition": "$.competition.name",
              "matchDate": "$.utcDate",
              "homeTeam": "$.homeTeam.name",
              "awayTeam": "$.awayTeam.name",
              "homeScore": "$.score.fullTime.home",
              "awayScore": "$.score.fullTime.away",
              "status": "$.status"
            }
          }
        },
        {
          "id": "liga-pro",
          "sheetName": "LigaPro",
          "type": "http",
          "enabled": true,
          "config": {
            "url": "https://api.example.com/ligapro/fixtures",
            "method": "GET",
            "apiKeyEnv": "LIGA_PRO_API_KEY",
            "apiKeyHeader": "Authorization",
            "fieldMapping": {
              "rowsPath": "$.data.fixtures",
              "competition": "$.league.name",
              "matchDate": "$.fixture.date",
              "homeTeam": "$.teams.home.name",
              "awayTeam": "$.teams.away.name",
              "homeScore": "$.goals.home",
              "awayScore": "$.goals.away",
              "status": "$.fixture.status.short"
            }
          }
        }
      ]
    }
  ]
}
